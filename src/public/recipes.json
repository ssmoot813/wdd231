[
    {
        "name": "Chocolate Chip Cookies",
        "description": "Classic chocolate chip cookies with a little coconut.",
        "ingredients": [
            {
                "name": "butter",
                "amounts": [
                    {
                        "amount": 1,
                        "unit": "lb"
                    }
                ],
                "processing": [
                    "softened"
                ]
            },
            {
                "name": "brown sugar",
                "amounts": [
                    {
                        "amount": 1.5,
                        "unit": "cup"
                    }
                ]
            },
            {
                "name": "white sugar",
                "amounts": [
                    {
                        "amount": 1,
                        "unit": "cup"
                    }
                ]
            },
            {
                "name": "eggs",
                "amounts": [
                    {
                        "amount": 3,
                        "unit": "each"
                    }
                ]
            },
            {
                "name": "vanilla",
                "amounts": [
                    {
                        "amount": 2,
                        "unit": "tsp"
                    }
                ]
            },
            {
                "name": "baking soda",
                "amounts": [
                    {
                        "amount": 1.5,
                        "unit": "tsp"
                    }
                ]
            },
            {
                "name": "salt",
                "amounts": [
                    {
                        "amount": 0.5,
                        "unit": "tsp"
                    }
                ]
            },
            {
                "name": "flour",
                "amounts": [
                    {
                        "amount": 5,
                        "unit": "cup"
                    }
                ],
                "notes": "We like 3 C white and 2 C whole wheat"
            },
            {
                "name": "semi-sweet chocolate chips",
                "amounts": [
                    {
                        "amount": 2,
                        "unit": "cup"
                    }
                ]
            },
            {
                "name": "shredded coconut",
                "amounts": [
                    {
                        "amount": 1,
                        "unit": "cup"
                    }
                ],
                "notes": "Use 1-2 cups to taste"
            }
        ],
        "steps": [
            {
                "step": "Cream the butter and sugar together, then beat in the eggs and vanilla"
            },
            {
                "step": "Mix in salt, soda and flour"
            },
            {
                "step": "Add chocolate chips and coconut"
            },
            {
                "step": "Bake 8-10 minutes at 350 F"
            }
        ]
    },
